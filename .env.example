# ─── Core ────────────────────────────────────────────────────────────────────
N8N_HOST=0.0.0.0
N8N_PORT=5678

# Public URL of your n8n instance (used for webhooks, OAuth callbacks)
# Example: https://n8n.yourdomain.com  or  http://localhost:5678
WEBHOOK_URL=http://localhost:5678

# ─── Security ────────────────────────────────────────────────────────────────
# Encrypt credentials stored in the database (generate a random 32-char string)
N8N_ENCRYPTION_KEY=change-me-use-a-random-32-char-string

# ─── Auth ────────────────────────────────────────────────────────────────────
# Basic auth to protect the n8n UI (optional but recommended for public deploys)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=strongpassword

# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite (no config needed, data stored in N8N_USER_FOLDER)
# For PostgreSQL (recommended for production):
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=your-db-password

# ─── Email / SMTP (for user invites & password reset) ────────────────────────
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.example.com
# N8N_SMTP_PORT=465
# N8N_SMTP_USER=user@example.com
# N8N_SMTP_PASS=your-smtp-password
# N8N_SMTP_SENDER=n8n@example.com

# ─── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV=production
GENERIC_TIMEZONE=UTC
